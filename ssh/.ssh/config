# Keys live in Bitwarden: its SSH agent signs, no private key on disk.
# IdentityFile picks which vault key to offer (Bitwarden would try them all):
# ssh matches the agent key against id_ed25519.pub, the private file may be absent.
Host *
  IdentityAgent ~/.bitwarden-ssh-agent.sock
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
