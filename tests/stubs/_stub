#!/usr/bin/env bash
# Fake for an external tool, invoked through a symlink named after the tool.
# Logs "<tool> <args>" to $STUB_LOG. Exit code and output come from
# $FAKE/<tool>/<key>.rc and .out (default: exit 0, no output).
set -u

tool=$(basename "$0")
echo "$tool $*" >>"$STUB_LOG"

key=$tool
if [ "$tool" = brew ]; then
    key=${1:-brew}
    if [ $# -ge 2 ] && [ "${2#-}" = "$2" ]; then key="$1-$2"; fi
fi

if [ "$tool" = defaults ]; then
    # -currentHost (setting_host, --record): its own values and plists
    host=
    if [ "${1:-}" = -currentHost ]; then
        host=/host
        shift
    fi
    plists="$FAKE/plists$host"
    dir="$FAKE/defaults$host/${2:-}"
    case "${1:-}" in
    read)
        [ -f "$dir/$3" ] || {
            echo "The domain/default pair of ($2, $3) does not exist" >&2
            exit 1
        }
        cut -d' ' -f2- "$dir/$3"
        ;;
    read-type)
        [ -f "$dir/$3" ] || exit 1
        echo "Type is $(cut -d' ' -f1 "$dir/$3")"
        ;;
    domains)
        # plists under $FAKE/plists/<domain>.plist (NSGlobalDomain isn't listed by the real one)
        for f in "$plists"/*.plist; do
            [ -e "$f" ] || continue
            d=$(basename "$f" .plist)
            d=${d%.after}
            [ "$d" = NSGlobalDomain ] || printf '%s\n' "$d"
        done | sort -u | paste -sd ',' - | sed 's/,/, /g'
        ;;
    export)
        # to stdout (setting_hotkey): the dictionaries written with -dict-add
        if [ "${3:-}" = - ]; then
            printf '<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict>'
            for d in "$dir"/*.dict; do
                [ -d "$d" ] || continue
                printf '<key>%s</key><dict>' "$(basename "$d" .dict)"
                for e in "$d"/*; do
                    [ -f "$e" ] && printf '<key>%s</key>%s' "$(basename "$e")" "$(cat "$e")"
                done
                printf '</dict>'
            done
            printf '</dict></plist>\n'
            exit 0
        fi
        # first export of a domain copies <domain>.plist, later ones <domain>.after.plist if present
        src="$plists/$2.plist"
        if [ -e "$plists/.exported-$2" ] && [ -e "$plists/$2.after.plist" ]; then
            src="$plists/$2.after.plist"
        fi
        mkdir -p "$plists"
        touch "$plists/.exported-$2"
        [ -e "$src" ] || exit 1
        cp "$src" "$3"
        ;;
    write)
        mkdir -p "$dir"
        if [ "${4:-}" = -dict-add ]; then
            mkdir -p "$dir/$3.dict"
            printf '%s' "$6" >"$dir/$3.dict/$5"
            exit 0
        fi
        case "$4" in
        -bool) case "$5" in true | yes | 1) v=1 ;; *) v=0 ;; esac; t=boolean ;;
        -int) v=$5 t=integer ;;
        -float) v=$5 t=float ;;
        -string) v=$5 t=string ;;
        *) v=$4 t=dictionary ;; # a plist value without a type: setting_plist
        esac
        echo "$t $v" >"$dir/$3"
        ;;
    esac
    exit 0
fi

# a per-subcommand result (<tool>-<first arg>) wins over the tool-wide one
[ -f "$FAKE/$tool/$tool-${1:-}.rc" ] && key="$tool-${1:-}"
rc=0
[ -f "$FAKE/$tool/$key.rc" ] && rc=$(cat "$FAKE/$tool/$key.rc")
[ -f "$FAKE/$tool/$key.out" ] && cat "$FAKE/$tool/$key.out"

if [ "$rc" -eq 0 ]; then
    case "$tool" in
    git) [ "${1:-}" = clone ] && mkdir -p "${!#}" ;;
    curl)
        prev=
        for a in "$@"; do
            if [ "$prev" = -o ]; then mkdir -p "$(dirname "$a")" && touch "$a"; fi
            prev=$a
        done
        ;;
    esac
fi
exit "$rc"
