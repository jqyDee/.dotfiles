# function to copy file to uni zid server
copyuni() {
  if [[ $# -lt 3 ]]; then
    echo "Usage: copyuni <to|from> <src-filepath> <dst-filepath>"
    return 1
  fi

  local to_from="$1"
  local src_filepath="$2"
  local dst_filepath="$3"

  if [[ "$to_from" =~ "to" ]]; then
    rsync -av --progress "$src_filepath" "csbb8241@zid-gpl.uibk.ac.at:/home/csbb8241/transfer/$dst_filepath"
  elif [[ "$to_from" =~ "from" ]]; then
    rsync -av --progress "csbb8241@zid-gpl.uibk.ac.at:/home/csbb8241/transfer/$src_filepath" "$dst_filepath"
  else
    echo "Usage: copyuni <to|from> <src-filepath> <dst-filepath>"
    return 1
  fi
}

# TODO: remove when chosen which wm to go with
# function to switch window manager between aerospace and yabai (+ skhd)
switchwm() {
  if pgrep -x AeroSpace > /dev/null; then
    echo "Switching AeroSpace -> yabai"
    osascript -e 'quit app "AeroSpace"'
    yabai --start-service
    skhd --start-service
  elif pgrep -x yabai > /dev/null; then
    echo "Switching yabai -> AeroSpace"
    yabai --stop-service
    skhd --stop-service
    open -a AeroSpace
  else
    echo "No window manager running, starting AeroSpace"
    open -a AeroSpace
  fi
}

