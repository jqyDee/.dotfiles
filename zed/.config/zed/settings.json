// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview": {
    "font_size": 18.0
  },
  "cli_default_open_behavior": "existing_window",
  "instrumentation": {
    "performance_profiler": {
      "enabled": false
    }
  },
  "disable_ai": false,
  "proxy": "",
  "git": {
    "file_diff": {
      "show_full_file": true
    },
    "blame": {
      "show_avatar": false
    },
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": false
    }
  },
  "fullscreen_mode": "native",
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enabled": true
  },
  "tabs": {
    "show_close_button": "always",
    "show_diagnostics": "all",
    "file_icons": false,
    "git_status": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_picture": false,
    "show_user_menu": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_worktree_name": true,
    "show_branch_name": true,
    "show_branch_status_icon": false
  },
  "search": {
    "button": false
  },
  "terminal": {
    "show_count_badge": false,
    "starts_open": true,
    "button": true
  },
  "status_bar": {
    "show_active_file": false,
    "pending_keystrokes_indicator": true,
    "line_endings_button": false,
    "cursor_position_button": true,
    "active_language_button": false
  },
  "seed_search_query_from_cursor": "selection",
  "lsp_results_location": "multi_buffer",
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": false
  },
  "tab_size": 4,
  "indent_guides": {
    "enabled": true,
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 0,
    "line_width": 2
  },
  "format_on_save": "on",
  "completion_menu_item_kind": "off",
  "lsp_document_colors": "border",
  "inlay_hints": {
    "show_background": false
  },
  "toolbar": {
    "quick_actions": true,
    "breadcrumbs": true
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "axes": {
      "vertical": true,
      "horizontal": false
    },
    "selected_symbol": true,
    "selected_text": true,
    "git_diff": true,
    "cursors": true,
    "show": "auto"
  },
  "gutter": {
    "git_gutter_width": {
      "custom": 6.0
    },
    "min_line_number_digits": 4,
    "folds": true,
    "bookmarks": true,
    "runnables": true,
    "line_numbers": true
  },
  "show_signature_help_after_edits": false,
  "relative_line_numbers": "enabled",
  "auto_signature_help": false,
  "mouse_wheel_zoom": false,
  "vertical_scroll_margin": 3.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "show_wrap_guides": true,
  "rounded_selection": true,
  "selection_highlight": true,
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "cursor_animation": {
    "enabled": false
  },
  "text_rendering_mode": "platform_default",
  "buffer_line_height": "standard",
  "redact_private_values": false,
  "show_edit_predictions": false,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "hard_tabs": false,
  "debugger": {
    "button": true,
    "dock": "bottom"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "languages": {
    "Rust": {
      "show_edit_predictions": false,
      "inlay_hints": {
        "enabled": true
      }
    },
    "C++": {
      "language_servers": ["clangd", "!sourcekit-lsp", "..."]
    },
    "C": {
      "language_servers": ["clangd", "!sourcekit-lsp", "..."]
    }
  },
  "diff_view_style": "unified",
  "vim": {
    "show_edit_predictions_in_normal_mode": false,
    "use_system_clipboard": "never",
    "toggle_relative_line_numbers": true
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": false,
    "sticky_scroll": true,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "auto_fold_dirs": true,
    "auto_reveal_entries": true,
    "indent_size": 20.0,
    "git_status": true,
    "folder_indicator": "icon",
    "file_icons": true,
    "entry_spacing": "standard",
    "button": true,
    "dock": "left"
  },
  "outline_panel": {
    "button": true,
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "button": true,
    "flexible": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "group_by": "status",
    "show_count_badge": false,
    "diff_stats": true,
    "collapse_untracked_diff": false,
    "tree_view": true,
    "dock": "left"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.1-pro-low"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "effort": "medium",
        "model": "opus"
      },
      "type": "registry"
    }
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "base_keymap": "JetBrains",
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark"
  }
}
