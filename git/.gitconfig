[user]
	name = Matti Fischbach
	email = matti.fischbach@web.de
	signingkey = /Users/mfischbach/.ssh/id_ed25519.pub
[core]
	autocrlf = input
[gpg]
	format = ssh
[gpg "ssh"]
	# sign through the Bitwarden agent, see ~/.config/git/ssh-sign
	program = /Users/mfischbach/.config/git/ssh-sign
[commit]
	gpgsign = true
[tag]
	gpgsign = true
